# Copied to .env by scripts\setup.ps1. .env is machine-specific and not committed.

# --- LangGraph -> ComfyUI (loopback only) ---
COMFYUI_URL=http://127.0.0.1:8188
# How long the agent waits while nothing at all comes back, in seconds (default 1200 = 20 minutes). Anything that
# keeps answering is waited for without a limit: model calls stream (every token counts), a ComfyUI run reports
# progress (every sampler step counts), the other tab's job renews its lock. Used by the image tab, the chat tab,
# the LM Connect node's read timeout and /coder/turn. Replaces COMFYUI_TIMEOUT_S, CHAT_TIMEOUT_S,
# BONSAI_WORKER_TIMEOUT_S and LMSTUDIO_TOKENS_PER_S (no longer read).
AGENT_IDLE_TIMEOUT_S=1200

# --- Models a client may pick (config/host_models.json ids; docs/configuration.md "モデルの選択") ---
# The image model (checkpoint, family, LoRAs, sampler values) and the inference model (router section, context,
# sampling) are entries of config/host_models.json. The Web UI and cirka send an id; a run without one uses these.
# CKPT_NAME, COMFY_MODEL_FAMILY, LORAS, CHROMA_LORAS and CHROMA_UNET_NAME are no longer read.
HOST_MODELS_PATH=config/host_models.json
# Empty = the router's LLM_MODEL with LLM_CONTEXT (inference) / the first image entry (image).
DEFAULT_INFERENCE_MODEL=
DEFAULT_IMAGE_MODEL=yiffinhell-vantablack
# Comma separated ids to offer as unavailable (models not installed on this machine are found automatically).
HOST_MODELS_DISABLE=
# Chroma only: machine-specific file overrides. Empty = the values in workflows/maps/flux.json
# (t5xxl_fp8_e4m3fn / ae / fp8_e4m3fn).
CHROMA_TEXT_ENCODER=
CHROMA_VAE=
CHROMA_WEIGHT_DTYPE=
# Speed: image size cap in pixels (default 1048576 = 1024x1024) and steps (default 28).
# Radeon 890M: 1024x1024 ~64 s/step, 768x768 ~26 s/step, 512x512 ~12 s/step.
CHROMA_MAX_PIXELS=
CHROMA_STEPS=

# --- The 27B on the llama.cpp router (written by scripts\setup-llamacpp.ps1 and scripts\setup-llm.ps1) ---
# llama-server.exe (the PrismML fork's Vulkan build; also runs the search workers) and the router's preset.
LLM_SERVER=
LLM_PRESET=
# The router's port (loopback only), its OpenAI-compatible URL, and the model name of the preset that the
# workflows send for the image tags (and the chat tab / /coder/turn when no model was picked). setup-llm.ps1
# regenerates workflows\ when these change. The preset has one section per config/host_models.json inference model.
LLM_PORT=8080
LLM_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3.8-27b-abliterated
# The 27B's context window (the preset's ctx-size, 4096). Each call's max_tokens (answer + thinking) is kept
# inside it (there is no time cap: calls have the idle timeout above).
LLM_CONTEXT=4096

# --- Written by scripts\setup-comfyui.ps1 (read by scripts\start-comfyui.ps1): ComfyUI in tools\comfyui ---
# Folder that contains ComfyUI's main.py, the python.exe of its venv, custom_nodes and models
COMFYUI_MAIN_DIR=
COMFYUI_PYTHON=
COMFYUI_CUSTOM_NODES_DIR=
COMFYUI_MODELS_DIR=
# Extra model folders as an extra_model_paths.yaml, only when set by hand. setup-comfyui.ps1 no longer writes it:
# it imports the models into tools\comfyui\models (hard links) from an earlier ComfyUI's folders and the
# Hugging Face cache (HF_HUB_CACHE / HF_HOME / %USERPROFILE%\.cache\huggingface\hub, shared with `hf download`).
COMFYUI_EXTRA_MODEL_PATHS=
COMFYUI_INPUT_DIR=
COMFYUI_OUTPUT_DIR=
# Extra ComfyUI arguments
COMFYUI_EXTRA_ARGS=

# --- Chat tab (graph "chat"): conversation and web search through Tor ---
# The image tab never reads these (its 27B call is made by the ComfyUI workflow).
CHAT_HISTORY_TURNS=12
# Tor (scripts\setup-tor.ps1 writes TOR_EXE; scripts\start-tor.ps1 or the chat tab starts it). socks5h only.
TOR_SOCKS_URL=socks5h://127.0.0.1:9050
TOR_REQUIRED=1
TOR_AUTOSTART=1
TOR_EXE=
# Search: results per query (1-30), parallel intents/readers (1-7; more than 3 rarely fits in 24 GB), one HTTP request through Tor (a stalled page is
# skipped, the run goes on), an optional budget of one reader over all its pages (0 = none)
SEARCH_MAX_RESULTS=5
SEARCH_FANOUT_WIDTH=3
SEARCH_TIMEOUT_S=30
SEARCH_TOTAL_TIMEOUT_S=0
# llm = the Qwen3.8 27B writes the plan, then is unloaded when the readers do not fit next to it and the
# Ternary-Bonsai-2-27B abliterated proxy leads; local = the proxy also plans (the 27B is not loaded at all).
SEARCH_PLANNER=llm
SEARCH_FILTER=1
SEARCH_CRITIQUE=1
# Ask Qwen3-1.7B whether a plain question (no search keyword) needs the web.
SEARCH_AUTO_ROUTE=1
# Think mode (the composer's 思考, or 自動 when it picks 思考): rounds scored against sub-questions until they are
# answered, new evidence stops coming, or one of these limits (rounds 1-50, pages 1-500, an optional time budget
# of the whole search in seconds: 0 = none).
# Results per intent read by the readers stays 4; the number of parallel readers never grows with the rounds.
SEARCH_MAX_ROUNDS=4
SEARCH_MAX_PAGES=12
SEARCH_WALL_CLOCK_S=0
SEARCH_HITS_PER_INTENT=4
# Claim verification (docs/claim-verification-design.md): the search answer is written
# only from claims the cards support, and the final text is audited sentence by sentence. 0 = the old synthesis.
CLAIM_VERIFY=1
# Claims per answer (1-200), quote length shown to the checker (80-20000), an optional time budget for extract + verify +
# audit in seconds (0 = none; every call has the idle timeout).
CLAIM_MAX=12
CLAIM_QUOTE_CHARS=400
CLAIM_TIMEOUT_S=0
# 0 = when the check fails, return the excerpts and no unaudited answer; 1 = the unaudited answer, marked.
CLAIM_VERIFY_FAIL_OPEN=0
# Thinking tokens added to a think-mode answer (the 27B, shown apart from the answer).
CHAT_THINK_TOKENS=3072
# Code sandbox (think mode, after approval only): scripts\setup-sandbox.ps1 pulls python:3.12-slim.
# The docker CLI is used with whatever engine it reaches; a CLI without an engine starts Docker Desktop for the
# approved run only; without a docker command nothing is started (the files are written, not run).
# Non-root uid:gid inside the container; runs are kept in artifacts\code\<run_id>. The container itself is
# stopped after 60 seconds (a fixed safety limit for model-written code).
SANDBOX_DOCKER=docker
SANDBOX_USER=10001:10001
# Optional hard limits on waiting for the other tab's job (empty = wait while it works: its holder renews the
# lock, and the image run has its own idle timeout): before the container runs, and before a chat run starts.
SANDBOX_WAIT_S=
JOB_LOCK_TIMEOUT_S=
# llama-server for the search workers (scripts\setup-llamacpp.ps1) and the GGUFs (scripts\setup-search-models.ps1).
BONSAI_LLAMA_SERVER=
BONSAI_MODELS_DIR=
# Empty = automatic per task (config\search_models.json + tools\bonsai\rank.json). Pins the reader model.
BONSAI_MODEL=
BONSAI_CTX=4096
# Memory kept free when deciding how many models fit (MB). Measured on the Ally X: 14.4 GB free with
# the 27B unloaded, 0.4 GB with the IQ3_M 27B loaded.
BONSAI_RESERVE_MB=3072
BONSAI_RANK=tools/bonsai/rank.json
BONSAI_BASE_PORT=18181
# Control loop of the chat tab (think mode, requests that need several tools in turn; docs/autonomous-controller-design.md).
# Tools per request (1-50) and an optional wall clock of the whole loop (empty = SEARCH_WALL_CLOCK_S, never more;
# both 0 = no time limit, the steps bound the loop).
CONTROLLER_MAX_STEPS=3
CONTROLLER_WALL_CLOCK_S=

# --- Limits that used to be constants (v0.10.0). Empty = the default shown; LangGraph reads them at start. ---
# The context window (LLM_CONTEXT, BONSAI_CTX) still caps every model call: raising a token budget past it
# changes nothing. The container limits (60 s, 2g, 2 CPUs, 256 pids, no network, 2 runs) stay fixed (AGENTS.md).
# Search: intents per round (1-7), a search intent tried on the providers in turn (empty = 3 x SEARCH_TIMEOUT_S),
# redirects, text kept of a fetched page, Tor start-up.
SEARCH_MAX_INTENTS=
SEARCH_INTENT_TIMEOUT_S=
SEARCH_MAX_REDIRECTS=
SEARCH_PAGE_TEXT_CHARS=
TOR_BOOTSTRAP_TIMEOUT_S=
# Readers: open_page calls per job (2), one page fetch (20 s), page text the reader sees (1200) and keeps for the
# claim check (3000), the proxy leader's context (8192).
BONSAI_MAX_TOOL_ROUNDS=
BONSAI_PAGE_TIMEOUT_S=
BONSAI_PAGE_CHARS=
BONSAI_PAGE_KEEP_CHARS=
BONSAI_LEADER_CTX=
# max_tokens per step: chat (1536, answer kept 512), search plan (400 / think 700), reader cards (700), critique
# (900), synthesis (1200 / think 1600, answer kept 800), claims extract / verify (1200 / 2000), sentences audited (24).
CHAT_TOKENS=
CHAT_ANSWER_MIN=
SEARCH_PLAN_TOKENS=
SEARCH_PLAN_TOKENS_THINK=
SEARCH_CARD_TOKENS=
SEARCH_CRITIQUE_TOKENS=
SEARCH_SYNTH_TOKENS=
SEARCH_SYNTH_TOKENS_THINK=
SEARCH_SYNTH_ANSWER_MIN=
CLAIM_EXTRACT_TOKENS=
CLAIM_VERIFY_TOKENS=
CLAIM_AUDIT_MAX=
# Chat: characters of one earlier turn sent back (4000), least room left for thinking (256).
CHAT_HISTORY_CHARS=
CHAT_THINK_RESERVE=
# Writing: outline (1500), draft (3000, answer kept 1200), revise (1200) tokens; edits per revision (8); draft tail
# sent when continuing (1200 chars); search results handed to the writer (1500 chars).
WRITE_OUTLINE_TOKENS=
WRITE_DRAFT_TOKENS=
WRITE_ANSWER_MIN=
WRITE_REVISE_TOKENS=
WRITE_MAX_EDITS=
WRITE_TAIL_CHARS=
WRITE_RESEARCH_CHARS=
# Code: tokens (3500, answer kept 1200), output tail shown (4000 chars) and handed to the fix (1000 / 1500 chars),
# output kept of a run (8192 bytes), files per plan (20) and their size (200000 bytes), Docker Desktop start (180 s).
CODE_TOKENS=
CODE_ANSWER_MIN=
CODE_SHOW_TAIL_CHARS=
CODE_FIX_STDOUT_CHARS=
CODE_FIX_STDERR_CHARS=
SANDBOX_TAIL_BYTES=
SANDBOX_MAX_FILES=
SANDBOX_MAX_FILE_BYTES=
SANDBOX_DESKTOP_START_S=
# Control loop: decision tokens (400), one trace entry (1000 chars) and what the controller reads of it (500).
CONTROLLER_DECISION_TOKENS=
CONTROLLER_SUMMARY_CHARS=
CONTROLLER_PROMPT_SUMMARY_CHARS=
# /coder/turn: max_tokens when cirka sends none (2048), least room before cirka must compact (256).
CODER_MAX_TOKENS=
CODER_MIN_ROOM=
# Job lock: a holder that disappeared frees it after this long (900 s); a working holder renews every 60 s.
JOB_LOCK_LEASE_S=
JOB_LOCK_RENEW_S=
# Image tab: one attached image (10 MB, 4096 px per side).
IMAGE_MAX_MB=
IMAGE_MAX_SIDE=
