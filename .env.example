# Copied to .env by scripts\setup.ps1. .env is machine-specific and not committed.

# --- LangGraph -> ComfyUI (loopback only) ---
COMFYUI_URL=http://127.0.0.1:8188
# Checkpoint file name in ComfyUI's models\checkpoints
CKPT_NAME=yiffInHell_yihVANTABLACK.safetensors
# Wait limit for one generation (seconds)
COMFYUI_TIMEOUT_S=600

# --- Written by scripts\setup-lmstudio.ps1 ---
# LM Studio model key used by the workflow (e.g. huihui-qwen3.8-27b-abliterated@iq3_m)
LMSTUDIO_MODEL=

# --- Written by scripts\setup-comfyui.ps1 (read by scripts\start-comfyui.ps1) ---
# Folder that contains ComfyUI's main.py, and the python.exe that runs it
COMFYUI_MAIN_DIR=
COMFYUI_PYTHON=
# Comfy Desktop only: data folder passed as --base-directory (custom_nodes, models, user)
COMFYUI_BASE_DIR=
COMFYUI_CUSTOM_NODES_DIR=
COMFYUI_EXTRA_MODEL_PATHS=
COMFYUI_INPUT_DIR=
COMFYUI_OUTPUT_DIR=
# Extra ComfyUI arguments, e.g. --enable-manager
COMFYUI_EXTRA_ARGS=
