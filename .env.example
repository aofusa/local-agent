# Copied to .env by scripts\setup.ps1. .env is machine-specific and not committed.

# --- LangGraph -> ComfyUI (loopback only) ---
COMFYUI_URL=http://127.0.0.1:8188
# Checkpoint file name in ComfyUI's models\checkpoints
CKPT_NAME=yiffInHell_yihVANTABLACK.safetensors
# Wait limit for one generation (seconds)
COMFYUI_TIMEOUT_S=600
# Model family: sdxl (yiffInHell, Danbooru tags) or flux (Chroma1-HD, English prose).
# For Chroma also set CKPT_NAME=chroma_v10HD.safetensors and run scripts\setup-comfyui-chroma.ps1.
COMFY_MODEL_FAMILY=sdxl
# LoRAs applied to every generation, in order. Empty = none.
# name[:model_strength[:clip_strength]], comma separated; the extension may be omitted.
# e.g. LORAS=KemonoStyleAV1.safetensors:0.8, CiviFur-30:0.6:0.5
LORAS=
# Chroma only: LoRAs for Chroma (SDXL LoRAs in LORAS are not applied), and file overrides.
# Empty = the values in workflows/maps/flux.json (t5xxl_fp8_e4m3fn / ae / fp8_e4m3fn).
CHROMA_LORAS=
CHROMA_UNET_NAME=
CHROMA_TEXT_ENCODER=
CHROMA_VAE=
CHROMA_WEIGHT_DTYPE=
# Speed: image size cap in pixels (default 1048576 = 1024x1024) and steps (default 28).
# Radeon 890M: 1024x1024 ~64 s/step, 768x768 ~26 s/step, 512x512 ~12 s/step.
CHROMA_MAX_PIXELS=
CHROMA_STEPS=

# --- Written by scripts\setup-lmstudio.ps1 ---
# LM Studio model key used by the workflow (e.g. huihui-qwen3.8-27b-abliterated@iq3_m)
LMSTUDIO_MODEL=

# --- Written by scripts\setup-comfyui.ps1 (read by scripts\start-comfyui.ps1) ---
# Folder that contains ComfyUI's main.py, and the python.exe that runs it
COMFYUI_MAIN_DIR=
COMFYUI_PYTHON=
# Comfy Desktop only: data folder passed as --base-directory (custom_nodes, models, user)
COMFYUI_BASE_DIR=
COMFYUI_CUSTOM_NODES_DIR=
COMFYUI_EXTRA_MODEL_PATHS=
COMFYUI_INPUT_DIR=
COMFYUI_OUTPUT_DIR=
# Extra ComfyUI arguments, e.g. --enable-manager
COMFYUI_EXTRA_ARGS=

# --- Chat tab (graph "chat"): conversation and web search through Tor ---
# The image tab never reads these. LM Studio is called directly only by the chat tab.
LMSTUDIO_URL=http://127.0.0.1:1234/v1
# One model call of the chat tab (conversation, writing, code, synthesis), seconds. 20 minutes.
CHAT_TIMEOUT_S=1200
CHAT_HISTORY_TURNS=12
# Tor (scripts\setup-tor.ps1 writes TOR_EXE; scripts\start-tor.ps1 or the chat tab starts it). socks5h only.
TOR_SOCKS_URL=socks5h://127.0.0.1:9050
TOR_REQUIRED=1
TOR_AUTOSTART=1
TOR_EXE=
# Search: results per query (1-8), parallel intents/readers (1-3), one request's read limit, whole search limit
SEARCH_MAX_RESULTS=5
SEARCH_FANOUT_WIDTH=3
SEARCH_TIMEOUT_S=30
SEARCH_TOTAL_TIMEOUT_S=150
# lmstudio = the Qwen3.8 27B writes the plan, then is unloaded when the readers do not fit next to it and the
# Ternary-Bonsai-2-27B abliterated proxy leads; local = the proxy also plans (LM Studio is not loaded at all).
SEARCH_PLANNER=lmstudio
SEARCH_FILTER=1
SEARCH_CRITIQUE=1
# Ask Qwen3-1.7B whether a plain question (no search keyword) needs the web.
SEARCH_AUTO_ROUTE=1
# Think mode (the composer's 思考, or 自動 when it picks 思考): rounds scored against sub-questions until they are
# answered, new evidence stops coming, or one of these limits (rounds 1-4, pages 1-12, whole search in seconds).
# Results per intent read by the readers stays 4; the number of parallel readers never grows with the rounds.
SEARCH_MAX_ROUNDS=4
SEARCH_MAX_PAGES=12
SEARCH_WALL_CLOCK_S=1200
SEARCH_HITS_PER_INTENT=4
# Thinking tokens added to a think-mode answer (LM Studio 27B, shown apart from the answer).
CHAT_THINK_TOKENS=3072
# Code sandbox (think mode, after approval only): scripts\setup-sandbox.ps1 pulls python:3.12-slim.
# Non-root uid:gid inside the container; runs are kept in artifacts\code\<run_id>; how long a run waits
# for the image tab to finish.
SANDBOX_DOCKER=docker
SANDBOX_USER=10001:10001
SANDBOX_WAIT_S=600
JOB_LOCK_TIMEOUT_S=30
# PrismML llama.cpp fork (scripts\setup-llamacpp.ps1) and the GGUFs (scripts\setup-search-models.ps1).
BONSAI_LLAMA_SERVER=
BONSAI_MODELS_DIR=
# Empty = automatic per task (config\search_models.json + tools\bonsai\rank.json). Pins the reader model.
BONSAI_MODEL=
BONSAI_CTX=4096
# Memory kept free when deciding how many models fit (MB). Measured on the Ally X: 14.4 GB free with
# LM Studio's model unloaded, 0.4 GB with the IQ3_M 27B loaded.
BONSAI_RESERVE_MB=3072
BONSAI_RANK=tools/bonsai/rank.json
BONSAI_BASE_PORT=18181
BONSAI_WORKER_TIMEOUT_S=120
