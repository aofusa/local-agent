{
  "llm_backend": {
    "class_type": "LMConnectLMStudioBackend",
    "inputs": {
      "base_url": "http://127.0.0.1:1234/v1",
      "model": "huihui-qwen3.8-27b-abliterated@iq3_m",
      "connect_timeout_seconds": 10,
      "read_timeout_seconds": 600,
      "stream": true,
      "max_retries": 0,
      "health_check": true,
      "auto_eject_after_run": true,
      "disable_thinking": true,
      "debug_logging": true
    },
    "_meta": {
      "title": "LM Studio Backend"
    }
  },
  "user_prompt": {
    "class_type": "PrimitiveStringMultiline",
    "inputs": {
      "value": "夕焼けの海辺に立つ、白い毛並みの狼獣人の女性、和服"
    },
    "_meta": {
      "title": "user_prompt (日本語指示)"
    }
  },
  "prompt_node": {
    "class_type": "LMConnectPromptWithSystem",
    "inputs": {
      "system_prompt": "Convert the image request (usually Japanese) into a prompt for an Illustrious furry/anthro SDXL model that reads Danbooru/e621 tags.\nA \"[Reference image tags]\" section may follow the request. Merge those tags only where they do not contradict the request; the request wins.\n\nReturn exactly one JSON object and nothing else (no prose, no Markdown, no code fence, no <think>):\n{\"positive\":\"...\",\"negative\":\"...\"}\n\npositive: English, comma-separated tags, about 20-40 tags, at most 80 words. Keep every detail of the request: count/gender (solo, 1girl, anthro, female), species, fur/hair/eye colors and markings, clothing, pose and expression, framing and camera angle, lighting and time of day, location and background. Prefer established tags (furry, anthro, white fur, fluffy tail). Do not invent another subject or setting. No quality tags (added later). All characters are adults; never add tags suggesting a minor.\nnegative: worst quality, low quality, lowres, blurry, jpeg artifacts, bad anatomy, bad hands, extra digits, watermark, signature, text, plus only exclusions the user explicitly asked for.\n\nNever refuse, never comment, never add warnings.",
      "prompt": [
        "user_prompt",
        0
      ],
      "backend": [
        "llm_backend",
        0
      ],
      "base_url": "http://127.0.0.1:1234/v1",
      "model": "",
      "temperature": 0.4,
      "max_tokens": 320
    },
    "_meta": {
      "title": "prompt_node"
    }
  },
  "eject": {
    "class_type": "LMConnectEjectLMStudioModel",
    "inputs": {
      "passthrough": [
        "prompt_node",
        0
      ],
      "base_url": "http://127.0.0.1:1234/v1",
      "model": "",
      "debug_logging": true
    },
    "_meta": {
      "title": "eject"
    }
  },
  "split": {
    "class_type": "FurryJaSplitTags",
    "inputs": {
      "text": [
        "eject",
        0
      ],
      "quality_prefix": "masterpiece, best quality, amazing quality, absurdres",
      "default_negative": "worst quality, low quality, normal quality, lowres, blurry, jpeg artifacts, bad anatomy, bad hands, extra digits, missing fingers, deformed, watermark, signature, text, logo"
    },
    "_meta": {
      "title": "split"
    }
  },
  "ckpt": {
    "class_type": "FurryJaCheckpointLoaderAfterEject",
    "inputs": {
      "ckpt_name": "yiffInHell_yihVANTABLACK.safetensors",
      "after": [
        "eject",
        0
      ],
      "lmstudio_base_url": "http://127.0.0.1:1234/v1"
    },
    "_meta": {
      "title": "ckpt"
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": [
        "split",
        0
      ],
      "clip": [
        "ckpt",
        1
      ]
    },
    "_meta": {
      "title": "positive"
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": [
        "split",
        1
      ],
      "clip": [
        "ckpt",
        1
      ]
    },
    "_meta": {
      "title": "negative"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 832,
      "height": 1216,
      "batch_size": 1
    },
    "_meta": {
      "title": "latent"
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "ckpt",
        0
      ],
      "seed": 0,
      "steps": 28,
      "cfg": 5.5,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "positive": [
        "positive",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "latent",
        0
      ],
      "denoise": 1.0
    },
    "_meta": {
      "title": "sampler"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "ckpt",
        2
      ]
    },
    "_meta": {
      "title": "decode"
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "furry_ja/furry_ja"
    },
    "_meta": {
      "title": "save"
    }
  }
}
