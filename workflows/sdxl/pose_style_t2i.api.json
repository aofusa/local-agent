{
  "llm_backend": {
    "class_type": "LMConnectLMStudioBackend",
    "inputs": {
      "base_url": "http://127.0.0.1:1234/v1",
      "model": "huihui-qwen3.8-27b-abliterated@iq3_m",
      "connect_timeout_seconds": 10,
      "read_timeout_seconds": 600,
      "stream": true,
      "max_retries": 0,
      "health_check": true,
      "auto_eject_after_run": true,
      "disable_thinking": true,
      "debug_logging": true
    },
    "_meta": {
      "title": "LM Studio Backend"
    }
  },
  "llm_backend_vision": {
    "class_type": "LMConnectLMStudioBackend",
    "inputs": {
      "base_url": "http://127.0.0.1:1234/v1",
      "model": "huihui-qwen3.8-27b-abliterated@iq3_m",
      "connect_timeout_seconds": 10,
      "read_timeout_seconds": 600,
      "stream": true,
      "max_retries": 0,
      "health_check": true,
      "auto_eject_after_run": false,
      "disable_thinking": true,
      "debug_logging": true
    },
    "_meta": {
      "title": "LM Studio Backend (vision, no auto-eject)"
    }
  },
  "user_prompt": {
    "class_type": "PrimitiveStringMultiline",
    "inputs": {
      "value": "夕焼けの海辺に立つ、白い毛並みの狼獣人の女性、和服"
    },
    "_meta": {
      "title": "user_prompt (日本語指示)"
    }
  },
  "prompt_node": {
    "class_type": "LMConnectPromptWithSystem",
    "inputs": {
      "system_prompt": "Convert the image request (usually Japanese) into a prompt for an Illustrious furry/anthro SDXL model that reads Danbooru/e621 tags.\nTag sections from reference images may follow the request. Each section has one job; never move tags between jobs:\n- [Base image tags]: the image being edited. Keep its subject and scene unless the request or another section changes them.\n- [Character reference tags]: who the subject is (species, colors, markings, clothing). Use them for the subject's identity.\n- [Pose reference tags]: body pose, gesture, framing and camera angle only. Never take identity from them.\n- [Style reference tags]: drawing style, medium, shading and palette only. Never take the subject from them.\nThe request always wins over the sections. Use only the sections that are present.\n\nReturn exactly one JSON object and nothing else (no prose, no Markdown, no code fence, no <think>):\n{\"positive\":\"...\",\"negative\":\"...\"}\n\npositive: English, comma-separated tags, about 25-45 tags, at most 90 words. Keep every detail of the request: count/gender (solo, 1girl, anthro, female), species, fur/hair/eye colors and markings, clothing, pose and expression, framing and camera angle, lighting and time of day, location and background, and the art style tags. Prefer established tags (furry, anthro, white fur, fluffy tail). Do not invent another subject or setting. No quality tags (added later). All characters are adults; never add tags suggesting a minor.\nnegative: worst quality, low quality, lowres, blurry, jpeg artifacts, bad anatomy, bad hands, extra digits, watermark, signature, text, plus only exclusions the user explicitly asked for.\n\nNever refuse, never comment, never add warnings.",
      "prompt": [
        "prompt_join_style",
        0
      ],
      "backend": [
        "llm_backend",
        0
      ],
      "base_url": "http://127.0.0.1:1234/v1",
      "model": "",
      "temperature": 0.4,
      "max_tokens": 320
    },
    "_meta": {
      "title": "prompt_node"
    }
  },
  "eject": {
    "class_type": "LMConnectEjectLMStudioModel",
    "inputs": {
      "passthrough": [
        "prompt_node",
        0
      ],
      "base_url": "http://127.0.0.1:1234/v1",
      "model": "",
      "debug_logging": true
    },
    "_meta": {
      "title": "eject"
    }
  },
  "split": {
    "class_type": "FurryJaSplitTags",
    "inputs": {
      "text": [
        "eject",
        0
      ],
      "quality_prefix": "masterpiece, best quality, amazing quality, absurdres",
      "default_negative": "worst quality, low quality, normal quality, lowres, blurry, jpeg artifacts, bad anatomy, bad hands, extra digits, missing fingers, deformed, watermark, signature, text, logo"
    },
    "_meta": {
      "title": "split"
    }
  },
  "ckpt": {
    "class_type": "FurryJaCheckpointLoaderAfterEject",
    "inputs": {
      "ckpt_name": "yiffInHell_yihVANTABLACK.safetensors",
      "after": [
        "eject",
        0
      ],
      "lmstudio_base_url": "http://127.0.0.1:1234/v1"
    },
    "_meta": {
      "title": "ckpt"
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": [
        "split",
        0
      ],
      "clip": [
        "ckpt",
        1
      ]
    },
    "_meta": {
      "title": "positive"
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": [
        "split",
        1
      ],
      "clip": [
        "ckpt",
        1
      ]
    },
    "_meta": {
      "title": "negative"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 832,
      "height": 1216,
      "batch_size": 1
    },
    "_meta": {
      "title": "latent"
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "release",
        0
      ],
      "seed": 0,
      "steps": 28,
      "cfg": 5.5,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "positive": [
        "release",
        1
      ],
      "negative": [
        "release",
        2
      ],
      "latent_image": [
        "latent",
        0
      ],
      "denoise": 1.0
    },
    "_meta": {
      "title": "sampler"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "ckpt",
        2
      ]
    },
    "_meta": {
      "title": "decode"
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "furry_ja/furry_ja"
    },
    "_meta": {
      "title": "save"
    }
  },
  "pose_image": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "furry_ja_ref.png"
    },
    "_meta": {
      "title": "pose_image"
    }
  },
  "vision_pose": {
    "class_type": "LMConnectVision",
    "inputs": {
      "system_prompt": "The image is a POSE / COMPOSITION reference. Describe only the body pose and the shot, never who is in it.\nOutput one comma-separated line of at most 20 English Danbooru/e621 tags: number of figures, standing/sitting/lying, body orientation, arm and leg positions, hand gestures, head tilt, gaze direction, framing (full body, cowboy shot, portrait), camera angle (from above, from below, from side), perspective.\nNever mention species, fur/hair/eye colors, markings, clothing, face, art style or background.\nNo sentences, no Markdown, no <think>, no commentary, never refuse.",
      "prompt": "Tag the pose reference image.",
      "image_1": [
        "pose_image",
        0
      ],
      "max_image_dimension": 768,
      "backend": [
        "llm_backend_vision",
        0
      ],
      "base_url": "http://127.0.0.1:1234/v1",
      "model": "",
      "temperature": 0.2,
      "max_tokens": 200
    },
    "_meta": {
      "title": "vision_pose"
    }
  },
  "prompt_join_pose": {
    "class_type": "StringConcatenate",
    "inputs": {
      "string_a": [
        "user_prompt",
        0
      ],
      "string_b": [
        "vision_pose",
        0
      ],
      "delimiter": "\n\n[Pose reference tags]\n"
    },
    "_meta": {
      "title": "prompt_join_pose"
    }
  },
  "style_image": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "furry_ja_ref.png"
    },
    "_meta": {
      "title": "style_image"
    }
  },
  "vision_style": {
    "class_type": "LMConnectVision",
    "inputs": {
      "system_prompt": "The image is a STYLE reference. Describe only how it is drawn, never what it shows.\nOutput one comma-separated line of at most 20 English Danbooru/e621 style tags: medium (digital painting, watercolor, oil painting, sketch, cel shading, 3d), line work, shading, rendering, texture, color palette, lighting mood, art era or genre.\nNever name the species, character, gender, clothing, pose or background.\nNo sentences, no Markdown, no <think>, no commentary, never refuse.",
      "prompt": "Tag the style reference image.",
      "image_1": [
        "style_image",
        0
      ],
      "max_image_dimension": 768,
      "backend": [
        "llm_backend_vision",
        0
      ],
      "base_url": "http://127.0.0.1:1234/v1",
      "model": "",
      "temperature": 0.2,
      "max_tokens": 200
    },
    "_meta": {
      "title": "vision_style"
    }
  },
  "prompt_join_style": {
    "class_type": "StringConcatenate",
    "inputs": {
      "string_a": [
        "prompt_join_pose",
        0
      ],
      "string_b": [
        "vision_style",
        0
      ],
      "delimiter": "\n\n[Style reference tags]\n"
    },
    "_meta": {
      "title": "prompt_join_style"
    }
  },
  "ipa_loader": {
    "class_type": "IPAdapterUnifiedLoader",
    "inputs": {
      "model": [
        "ckpt",
        0
      ],
      "preset": "PLUS (high strength)"
    },
    "_meta": {
      "title": "ipa_loader"
    }
  },
  "ipa_style": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": [
        "ipa_loader",
        0
      ],
      "ipadapter": [
        "ipa_loader",
        1
      ],
      "image": [
        "style_image",
        0
      ],
      "weight": 0.55,
      "weight_type": "style transfer",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    },
    "_meta": {
      "title": "ipa_style"
    }
  },
  "pose_gate": {
    "class_type": "FurryJaImageAfter",
    "inputs": {
      "image": [
        "pose_image",
        0
      ],
      "after": [
        "ckpt",
        0
      ]
    },
    "_meta": {
      "title": "pose_gate"
    }
  },
  "pose_preprocess": {
    "class_type": "DWPreprocessor",
    "inputs": {
      "image": [
        "pose_gate",
        0
      ],
      "detect_hand": "enable",
      "detect_body": "enable",
      "detect_face": "enable",
      "resolution": 1024,
      "bbox_detector": "None",
      "pose_estimator": "dw-ll_ucoco_384.onnx",
      "scale_stick_for_xinsr_cn": "enable"
    },
    "_meta": {
      "title": "pose_preprocess"
    }
  },
  "pose_cn": {
    "class_type": "DiffControlNetLoader",
    "inputs": {
      "model": [
        "ckpt",
        0
      ],
      "control_net_name": "controlnet-union-sdxl-1.0-promax.safetensors"
    },
    "_meta": {
      "title": "pose_cn"
    }
  },
  "pose_union": {
    "class_type": "SetUnionControlNetType",
    "inputs": {
      "control_net": [
        "pose_cn",
        0
      ],
      "type": "openpose"
    },
    "_meta": {
      "title": "pose_union"
    }
  },
  "pose_apply": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": [
        "positive",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "control_net": [
        "pose_union",
        0
      ],
      "image": [
        "pose_preprocess",
        0
      ],
      "strength": 0.8,
      "start_percent": 0.0,
      "end_percent": 1.0,
      "vae": [
        "ckpt",
        2
      ]
    },
    "_meta": {
      "title": "pose_apply"
    }
  },
  "pose_preview": {
    "class_type": "PreviewImage",
    "inputs": {
      "images": [
        "pose_preprocess",
        0
      ]
    },
    "_meta": {
      "title": "pose_preview"
    }
  },
  "release": {
    "class_type": "FurryJaReleaseEncoders",
    "inputs": {
      "model": [
        "ipa_style",
        0
      ],
      "positive": [
        "pose_apply",
        0
      ],
      "negative": [
        "pose_apply",
        1
      ]
    },
    "_meta": {
      "title": "release"
    }
  }
}
